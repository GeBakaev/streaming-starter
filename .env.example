# Copy to .env (git-ignored) and change the values. docker compose reads it automatically.
# Defaults in docker-compose.yml are for local dev only.
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
# Secret key for HMAC-hashing account_id before it lands in the lake.
# In AWS this would live in Secrets Manager / KMS, never in code or git.
HMAC_KEY=change-me-to-a-long-random-string
